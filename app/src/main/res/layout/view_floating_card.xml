<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="#1A1A2E"
    app:cardCornerRadius="16dp"
    app:cardElevation="16dp"
    app:strokeWidth="1dp"
    app:strokeColor="#2A2A4E">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="12dp"
        android:paddingBottom="16dp"
        android:paddingHorizontal="16dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CSV Data"
                android:textColor="#E94560"
                android:textStyle="bold"
                android:textSize="14sp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/btnCardClose"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_close"
                android:background="?selectableItemBackgroundBorderless"
                android:scaleType="centerInside"
                app:tint="#AAAAAA" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#2A2A4E"
            android:layout_marginVertical="8dp" />

        <!-- Dynamic Rows -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fadeScrollbars="false"
            android:requiresFadingEdge="vertical">

            <LinearLayout
                android:id="@+id/cardRowsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:divider="@drawable/row_divider"
                android:showDividers="middle" />
        </ScrollView>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#2A2A4E"
            android:layout_marginVertical="8dp" />

        <!-- Sleek Navigation Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:background="@drawable/card_nav_bg"
            android:gravity="center"
            android:layout_marginTop="8dp">

            <ImageButton
                android:id="@+id/btnCardPrev"
                android:layout_width="48dp"
                android:layout_height="match_parent"
                android:src="@drawable/arrow_left"
                android:background="?selectableItemBackgroundBorderless"
                app:tint="#FFFFFF" />

            <Space
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvCardRowCounter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1 / 250"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Space
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/btnCardNext"
                android:layout_width="48dp"
                android:layout_height="match_parent"
                android:src="@drawable/arrow_right"
                android:background="?selectableItemBackgroundBorderless"
                app:tint="#FFFFFF" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
